#!/command/with-contenv sh
set -eu

cd /rails

: "${DB_HOST:=127.0.0.1}"
: "${DB_PORT:=5432}"
: "${POSTGRES_USER:=sure_user}"
: "${POSTGRES_PASSWORD:=internal_sure_pass}"
: "${POSTGRES_DB:=sure_production}"
: "${REDIS_URL:=redis://127.0.0.1:6379/1}"

export DB_HOST DB_PORT POSTGRES_USER POSTGRES_PASSWORD POSTGRES_DB REDIS_URL

echo "Waiting for authenticated PostgreSQL access to ${POSTGRES_DB}..."
attempts=0
until PGPASSWORD="${POSTGRES_PASSWORD}" psql \
  -h "${DB_HOST}" \
  -p "${DB_PORT}" \
  -U "${POSTGRES_USER}" \
  -d "${POSTGRES_DB}" \
  -Atqc "SELECT 1" >/dev/null 2>&1; do
  attempts=$((attempts + 1))
  if [ "${attempts}" -ge 150 ]; then
    echo "PostgreSQL did not become ready for ${POSTGRES_USER}@${DB_HOST}:${DB_PORT}/${POSTGRES_DB}" >&2
    exit 1
  fi
  sleep 2
done

echo "Running Sure database preparations (create/migrate/seed)..."
bundle exec rails db:prepare

# Clean stale pid
rm -f tmp/pids/server.pid

# Launch Ruby Server
exec bin/rails server -b 0.0.0.0
